# Conexão da aplicação. Em produção: Transaction pooler do Supabase (porta 6543), com ?sslmode=require.
# Não use ?pgbouncer=true (é só do Prisma; o postgres.js recusa)
DATABASE_URL=
# Usada só por db:migrate. Em produção: Session pooler do Supabase (porta 5432, IPv4, aceita DDL),
# com ?sslmode=require. Se vazia, usa DATABASE_URL (local)
DATABASE_URL_MIGRACAO=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do sistema, sem barra no fim (links de convite e de nova senha).
# Local: http://127.0.0.1:3000. Produção: o domínio do Railway
NEXT_PUBLIC_SITE_URL=
# Integrações (fatia 6c). Cada integração fica desligada enquanto faltar alguma das suas variáveis;
# Admin › Integrações mostra quais faltam (só os nomes). Nunca coloque estes valores no código ou no banco.
# Segredo das rotas /api/cron/* (o serviço cron do Railway manda "Authorization: Bearer <CRON_SECRET>").
# Vazio: as rotas de cron respondem 503 e nada roda
CRON_SECRET=
# Trello: chave e token da conta que cria os cartões; id da lista "Operações" do quadro
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_LISTA_ID=
# Google Drive: conta de serviço (e-mail e chave privada PEM, aceita \n literais) e a pasta raiz,
# que precisa estar num drive compartilhado
GOOGLE_SA_EMAIL=
GOOGLE_SA_CHAVE=
GOOGLE_DRIVE_PASTA_RAIZ_ID=
# IA (chat e "Reescrever com IA"). IA_MODELO é opcional (padrão claude-opus-5-5)
ANTHROPIC_API_KEY=
IA_MODELO=
# Produção (Railway)
# TZ=America/Cuiaba
# HOSTNAME=0.0.0.0
