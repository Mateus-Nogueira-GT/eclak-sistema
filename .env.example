# Conexão da aplicação. Em produção: pooler do Supabase (modo transaction, porta 6543) com ?pgbouncer=true
DATABASE_URL=
# Conexão direta (porta 5432) usada só por db:migrate. Se vazia, usa DATABASE_URL (local)
DATABASE_URL_MIGRACAO=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Endereço público do sistema, sem barra no fim (links de convite e de nova senha).
# Local: http://127.0.0.1:3000. Produção: o domínio do Railway
NEXT_PUBLIC_SITE_URL=
# Produção (Railway)
# TZ=America/Cuiaba
# HOSTNAME=0.0.0.0
